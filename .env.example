# Application
NODE_ENV=development

# Backend
PORT=3000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Database (local PostgreSQL)
# If your local PostgreSQL uses peer trust auth, this can be:
# DATABASE_URL=postgres://localhost:5432/ai_novel
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_novel

# Automated tests refuse any database whose name does not end in `_test`.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_novel_test

# AI Provider defaults. You can also configure these in the app settings page.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxx
# Required when API keys are saved from the app. Generate with: openssl rand -base64 32
# AI_CREDENTIAL_MASTER_KEY=base64-encoded-32-byte-key
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=70
# AI_EMBEDDING_PROVIDER=openai-compatible
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_KEY=sk-xxx
